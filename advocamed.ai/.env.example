# Gemini API Key (Server-Side Only in api/analyze.js & api/appeal.js)
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# EMERGENCY KILL SWITCHES & AUTO-FUSE CIRCUIT BREAKER SETTINGS
# ============================================================================
# 1. Set ENABLE_AI_TOOL=false to freeze ONLY the AI Bill Scanner while keeping all 50+ Hospital SEO pages & AdSense running
ENABLE_AI_TOOL=true

# 2. Set SITE_LOCKDOWN=true to return HTTP 503 Scheduled Maintenance on API routes (preserves Google SEO rankings)
SITE_LOCKDOWN=false

# 3. Unmanned Auto-Fuse Limits (Automatically pauses AI API for 6 hours if global calls exceed these limits)
MAX_HOURLY_AI_CALLS=30
MAX_DAILY_AI_CALLS=100
